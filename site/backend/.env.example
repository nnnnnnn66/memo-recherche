# ============================================================================
#  Configuration backend — copier en ".env" et compléter.
#  ⚠ Le fichier .env n'est JAMAIS versionné ni exposé publiquement.
# ============================================================================

NODE_ENV=development
PORT=4000

# Origine autorisée du frontend (CORS + vérification Origin)
FRONTEND_ORIGIN=http://localhost:5173

# MySQL — pool de connexions géré par Prisma (connection_limit / pool_timeout)
DATABASE_URL="mysql://memoire_app:MOT_DE_PASSE_ICI@127.0.0.1:3306/memoire_recherche?connection_limit=15&pool_timeout=10"

# Session JWT (cookie HttpOnly) — générer une valeur aléatoire longue (>= 48 caractères)
JWT_SECRET=CHANGE_MOI_PAR_UNE_LONGUE_CHAINE_ALEATOIRE
JWT_TTL_HOURS=12

# ---------------------------------------------------------------------------
#  Orchestrateur Python (FastAPI) — SEUL interlocuteur du site
# ---------------------------------------------------------------------------
ORCHESTRATOR_URL=http://127.0.0.1:8000

# Limitation de débit vers le moteur
CONSULTATION_RATE_PER_MINUTE=8
CONSULTATION_RATE_PER_DAY=150
ENGINE_MAX_CONCURRENCY=8
CONSULTATION_MAX_CHARS=4000
